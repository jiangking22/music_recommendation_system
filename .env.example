# Local Compose configuration. Do not add real credentials to this file.
POSTGRES_DB=music_recommendation
POSTGRES_USER=music
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://music:change-me-for-local-development@postgres:5432/music_recommendation
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=http://localhost:3000
# Explicit local HTTP mode. Production requires HTTPS and AUTH_COOKIE_SECURE=true.
APP_ENVIRONMENT=development
AUTH_COOKIE_SECURE=false
# Web server only; Compose fixes this to http://api:8000. No public API URL.
API_INTERNAL_URL=http://127.0.0.1:8000
# Per 15-minute window; proxied requests conservatively share a source bucket.
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_SOURCE_LIMIT=60
AUTH_REGISTER_SOURCE_LIMIT=5
ENABLE_QQ_PROVIDER=true
# Set false for a fully offline catalog demo / 无业务外网的固定曲库演示。
ENABLE_MUSIC_PROVIDERS=true
ENABLE_MUSICBRAINZ_PROVIDER=true
# Optional supported-platform web clues / 可选音乐详情页线索，需独立 Key。
BRAVE_SEARCH_API_KEY=
# One bounded Agent. No key uses the documented local rule-based fallback.
LLM_PROVIDER=local
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
AGENT_TIMEOUT_SECONDS=30
